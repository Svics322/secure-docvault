# Приклад конфігурації. Секрети тут НЕ зберігаються.
# Файл .env створюється локально і не комітиться (див. .gitignore).

API_BASE_URL=http://127.0.0.1:8000
API_HOST=127.0.0.1
API_PORT=8000
DEBUG=false

# --- Секрети ---------------------------------------------------------------
# Залиште порожніми: сервер згенерує їх сам при першому запуску
# і атомарно запише у .env (у корені проєкту).
# JWT_SECRET_KEY             — 64 hex-символи (32 байти ентропії)
# FILE_ENCRYPTION_KEY        — 64 hex-символи (ключ AES-256 для файлів)
# SIGNING_KEY_ENCRYPTION_KEY — 64 hex-символи (захист приватних ключів ЕЦП)
# Згенерувати вручну: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
FILE_ENCRYPTION_KEY=
SIGNING_KEY_ENCRYPTION_KEY=

# Попередні ключі шифрування (лише для читання старих файлів), через кому.
# FILE_ENCRYPTION_KEY_OLD=

# --- Cookie / CSRF ---------------------------------------------------------
# Secure=true вимагає HTTPS. Для http://localhost сучасні браузери це дозволяють.
COOKIE_SECURE=true
COOKIE_SAMESITE=strict

# --- Обмеження -------------------------------------------------------------
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,gif,txt,csv,md,docx,xlsx,pptx,zip
RATE_LIMIT_ENABLED=true
WAF_ENABLED=true
TRUST_PROXY=false
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:3000

# --- Шляхи (за замовчуванням — корінь проєкту) -----------------------------
# DOCVAULT_DB_PATH=
# DOCVAULT_UPLOAD_DIR=
# DOCVAULT_LOG_DIR=
